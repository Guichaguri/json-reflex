{
  "name": "@sdui-reflex/expressions",
  "version": "1.0.0",
  "description": "A lightweight expression processor for evaluating expressions in a secure and efficient manner.",
  "keywords": [
    "expression",
    "processor",
    "parser",
    "evaluator",
    "react",
    "sdui"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "test": "vitest",
    "coverage": "vitest run --coverage --coverage.include=src/**/*.ts",
    "prepack": "tsdown",
    "build:test": "tsc --project tsconfig.test.json",
    "sample:react": "vite ./samples/react",
    "sample:react-sdui": "vite ./samples/react-sdui",
    "sample:vanilla-sdui": "vite ./samples/vanilla-sdui"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./std": {
      "import": {
        "types": "./dist/std/index.d.ts",
        "default": "./dist/std/index.js"
      },
      "require": {
        "types": "./dist/std/index.d.cts",
        "default": "./dist/std/index.cjs"
      }
    }
  },
  "dependencies": {
    "jsep": "^1.6.0"
  },
  "peerDependencies": {
    "react": ">=16.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.21.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
